{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
   "backend": {
  "root": "backend/",
  "runtime": "container",
  "entrypoint": "Dockerfile.ocr"
}
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}